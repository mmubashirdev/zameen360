generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OtpType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

enum ActivityStatus {
  SUCCESS
  FAILED
  SUSPICIOUS
}

// ==================== MODELS ====================

model User {
  id             Int           @id @default(autoincrement())
  fullName       String        @map("full_name")
  email          String        @unique
  phone          String?
  passwordHash   String        @map("password_hash")
  role           Role          @default(BUYER)
  city           String?
  profilePicture String?       @map("profile_picture")
  trustScore     Decimal?      @default(0) @map("trust_score") @db.Decimal(5, 2)
  isVerified     Boolean       @default(false) @map("is_verified")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  googleId       String?       @unique
  profile        UserProfile?
  sellerDetail   SellerDetail?

  verifications  UserVerification[]
  sessions       UserSession[]
  passwordResets PasswordReset[]
  activityLogs   UserActivityLog[]

  @@map("users")
}

model UserProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  bio             String?
  whatsappNumber  String?   @map("whatsapp_number")
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          Gender?
  address         String?
  profileComplete Boolean   @default(false) @map("profile_complete")
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  sessionToken String    @map("session_token")
  deviceType   String?   @map("device_type")
  browser      String?
  ipAddress    String?   @map("ip_address")
  loginTime    DateTime  @default(now()) @map("login_time")
  logoutTime   DateTime? @map("logout_time")
  isActive     Boolean   @default(true) @map("is_active")
  rememberMe   Boolean   @default(false) @map("remember_me")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model UserVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  otpCode    String    @map("otp_code")
  otpType    OtpType   @map("otp_type")
  otpExpiry  DateTime  @map("otp_expiry")
  isUsed     Boolean   @default(false) @map("is_used")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model PasswordReset {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  resetToken  String    @map("reset_token")
  tokenExpiry DateTime  @map("token_expiry")
  isUsed      Boolean   @default(false) @map("is_used")
  resetAt     DateTime? @map("reset_at")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model SellerDetail {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  totalListings  Int      @default(0) @map("total_listings")
  activeListings Int      @default(0) @map("active_listings")
  soldProperties Int      @default(0) @map("sold_properties")
  sellerRating   Decimal? @default(0) @map("seller_rating") @db.Decimal(3, 2)
  isPremium      Boolean  @default(false) @map("is_premium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_details")
}

model UserActivityLog {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  action      String
  description String?
  ipAddress   String?        @map("ip_address")
  device      String?
  status      ActivityStatus @default(SUCCESS)
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity_logs")
}

model Property {
  id                    Int      @id @default(autoincrement())

  // Basic Info
  purpose               String?
  propertyType          String?
  title                 String?
  description           String?

  // Property Details
  areaSize              String?
  areaUnit              String?
  bedrooms              String?
  bathrooms             String?
  floors                String?
  parking               String?
  yearBuilt             String?
  furnishing            String?
  possession            String?
  facing                String?

  // Pricing
  price                 BigInt?
  negotiable            Boolean  @default(false)
  installmentAvailable  Boolean  @default(false)
  downPayment           BigInt?
  monthlyInstallment    BigInt?
  duration              String?
  monthlyRent           BigInt?
  securityDeposit       BigInt?
  advanceMonths         String?

  // Amenities
  amenities             String[] @default([])

  // Location
  city                  String?
  locality              String?
  address               String?

  // Media
  images                String[] @default([])
  videoUrl              String?
  floorPlan             String?

  // Status
  status                String   @default("published")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([city])
  @@index([purpose])
  @@index([propertyType])
  @@index([price])
}
