generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  BUYER
  SELLER
  ADMIN
}
enum Gender {
  MALE
  FEMALE
  OTHER
}
enum OtpType {
  EMAIL
  PHONE
  PASSWORD_RESET
}
enum ActivityStatus {
  SUCCESS
  FAILED
  SUSPICIOUS
}
model Admin {
  id        Int      @id @default(autoincrement())
  // fullName  String   @map("")
  email     String   @default("ismalumair912@gmail.com")
  passwordHash String @default("12345678Aa@")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("admins")
}
model User {
  id             Int      @id @default(autoincrement())
  fullName       String   @map("full_name")
  email          String   @unique
  phone          String?
  passwordHash   String   @map("password_hash")
  role           Role     @default(BUYER)
  city           String?
  profilePicture String?  @map("profile_picture")
  trustScore     Decimal? @default(0) @map("trust_score") @db.Decimal(5, 2)
  isVerified     Boolean  @default(false) @map("is_verified")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  googleId       String?  @unique
  profile        UserProfile?
  sellerDetail   SellerDetail?
  verifications  UserVerification[]
  sessions       UserSession[]
  passwordResets PasswordReset[]
  activityLogs   UserActivityLog[]
  properties     Property[]
  @@map("users")
}
model UserProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  bio             String?
  whatsappNumber  String?   @map("whatsapp_number")
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          Gender?
  address         String?
  profileComplete Boolean   @default(false) @map("profile_complete")
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}
model SellerDetail {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  totalListings  Int      @default(0) @map("total_listings")
  activeListings Int      @default(0) @map("active_listings")
  soldProperties Int      @default(0) @map("sold_properties")
  sellerRating   Decimal? @default(0) @map("seller_rating") @db.Decimal(3, 2)
  isPremium      Boolean  @default(false) @map("is_premium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("seller_details")
}
model UserVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  otpCode    String    @map("otp_code")
  otpType    OtpType   @map("otp_type")
  otpExpiry  DateTime  @map("otp_expiry")
  isUsed     Boolean   @default(false) @map("is_used")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_verifications")
}
model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  sessionToken String    @map("session_token")
  deviceType   String?   @map("device_type")
  browser      String?
  ipAddress    String?   @map("ip_address")
  loginTime    DateTime  @default(now()) @map("login_time")
  logoutTime   DateTime? @map("logout_time")
  isActive     Boolean   @default(true) @map("is_active")
  rememberMe   Boolean   @default(false) @map("remember_me")
  createdAt    DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_sessions")
}
model PasswordReset {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  resetToken  String    @map("reset_token")
  tokenExpiry DateTime  @map("token_expiry")
  isUsed      Boolean   @default(false) @map("is_used")
  resetAt     DateTime? @map("reset_at")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("password_resets")
}
model UserActivityLog {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  action      String
  description String?
  ipAddress   String?        @map("ip_address")
  device      String?
  status      ActivityStatus @default(SUCCESS)
  createdAt   DateTime       @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_activity_logs")
}
model Property {
  id                   Int      @id @default(autoincrement())
  purpose              String?
  propertyType         String?  @map("property_type")
  title                String?
  description          String?
  areaSize             String?  @map("area_size")
  areaUnit             String?  @map("area_unit")
  bedrooms             String?
  bathrooms            String?
  floors               String?
  parking              String?
  yearBuilt            String?  @map("year_built")
  furnishing           String?
  possession           String?
  facing               String?
  price                BigInt?
  negotiable           Boolean  @default(false)
  installmentAvailable Boolean  @default(false) @map("installment_available")
  downPayment          BigInt?  @map("down_payment")
  monthlyInstallment   BigInt?  @map("monthly_installment")
  duration             String?
  monthlyRent          BigInt?  @map("monthly_rent")
  securityDeposit      BigInt?  @map("security_deposit")
  advanceMonths        String?  @map("advance_months")
  amenities            String[] @default([])
  city                 String?
  locality             String?
  address              String?
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  images               String[] @default([])
  videoUrl             String?  @map("video_url")
  floorPlan            String?  @map("floor_plan")
  status               String   @default("pending")
  userId               Int?     @map("user_id")
  approvedAt           DateTime? @map("approved_at")
  rejectedAt           DateTime? @map("rejected_at")
  approvedBy           Int?     @map("approved_by")
  rejectionReason      String?  @map("rejection_reason")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([city])
  @@index([purpose])
  @@index([propertyType])
  @@index([price])
  @@index([latitude, longitude])
  @@map("properties")
}
