model SellerDetail {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  totalListings  Int      @default(0) @map("total_listings")
  activeListings Int      @default(0) @map("active_listings")
  soldProperties Int      @default(0) @map("sold_properties")
  sellerRating   Decimal? @default(0) @map("seller_rating") @db.Decimal(3, 2)
  isPremium      Boolean  @default(false) @map("is_premium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_details")
}
